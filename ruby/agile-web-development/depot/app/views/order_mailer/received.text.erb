<%= t('.dear', name: @order.name) %>

<%= t('.thanks') %>

<%= t('.items_ordered') %>

<%= render @order.line_items -%>

<%= t('.subtotal', amount: localized_currency(@order.subtotal)) %>
<% if @order.discount_percent.positive? -%>
<%= t('.discount', percent: @order.discount_percent, amount: localized_currency(@order.discount_amount)) %>
<% end -%>
<%= t('.total', amount: localized_currency(@order.total_price)) %>

<%= t('.ships_notice') %>
