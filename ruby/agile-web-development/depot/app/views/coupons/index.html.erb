<% content_for :title, "Coupons" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium
              rounded-lg inline-block" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <div class="flex justify-between items-center pb-8">
    <h1 class="font-bold text-4xl">Coupons</h1>
  </div>

  <table id="coupons" class="mx-auto">
    <thead>
      <tr>
        <th class="px-3 text-left">Code</th>
        <th class="px-3 text-left">Discount</th>
        <th class="px-3"></th>
      </tr>
    </thead>

    <tfoot>
      <tr>
        <td colspan="3">
          <div class="mt-8">
            <%= link_to 'New coupon',
                        new_coupon_path,
                        class: "inline rounded-lg py-3 px-5 bg-green-600
                                text-white block font-medium" %>
          </div>
        </td>
      </tr>
    </tfoot>

    <tbody>
      <% @coupons.each do |coupon| %>
        <tr class="<%= cycle('bg-green-50', 'bg-white') %>">
          <td class="px-3 py-3 font-mono"><%= coupon.code %></td>
          <td class="px-3"><%= coupon.discount_percent %>%</td>
          <td class="px-3">
            <%= button_to 'Destroy',
                          coupon,
                          method: :delete,
                          class: 'hover:underline',
                          data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
