<%= form_with(model: coupon, class: "contents") do |form| %>
  <% if coupon.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(coupon.errors.count, "error") %> prohibited this coupon from being saved:</h2>

      <ul class="list-disc ml-6">
        <% coupon.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :code %>
    <%= form.text_field :code, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": coupon.errors[:code].none?, "border-red-400 focus:outline-red-600": coupon.errors[:code].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :discount_percent, "Discount (%)" %>
    <%= form.number_field :discount_percent, min: 1, max: 100, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": coupon.errors[:discount_percent].none?, "border-red-400 focus:outline-red-600": coupon.errors[:discount_percent].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :expires_on, "Expires on (optional)" %>
    <%= form.date_field :expires_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": coupon.errors[:expires_on].none?, "border-red-400 focus:outline-red-600": coupon.errors[:expires_on].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
