<%= turbo_frame_tag(dom_id(product)) do %>
  <li class='flex mb-6'>
    <%= button_to line_items_path(product_id: product, locale: I18n.locale),
      form_class: "mr-6",
      class: "block p-0 border-0 bg-transparent cursor-pointer",
      "aria-label": t(".add_html") do %>
      <%= image_tag(product.image,
        class: 'object-contain w-40 h-48 shadow', alt: product.title) %>
    <% end %>

    <div>
      <h2 class="font-bold text-lg mb-3"><%= product.title %></h2>

      <p>
        <%= sanitize(product.description) %>
      </p>

      <div class="mt-3">
        <%= number_to_currency(product.price) %>

        <%= button_to t(".add_html"),
            line_items_path(product_id: product, locale: I18n.locale),
            form_class: "inline",
            class: 'ml-4 rounded-lg py-1 px-2
                    text-white bg-green-600' %>
      </div>
    </div>
  </li>
<% end %>
