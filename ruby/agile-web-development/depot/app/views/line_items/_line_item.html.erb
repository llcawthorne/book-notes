<% if line_item == @current_item %>
  <tr class="line-item-highlight" id="<%= dom_id(line_item) %>">
<% else %>
  <tr id="<%= dom_id(line_item) %>">
<% end %>
  <td class="text-right"><%= line_item.quantity %></td>
  <td>&times;</td>
  <td class="pr-2">
    <%= line_item.product.title %>
  </td>
  <td class="text-right font-bold">
    <%= number_to_currency(line_item.total_price) %>
  </td>
  <td class="pl-2">
    <% if line_item.cart_id.present? %>
      <%= button_to t('.decrement'), decrement_line_item_path(line_item, locale: I18n.locale),
        method: :patch,
        form_class: "inline",
        class: "rounded-md py-1 px-2 text-white bg-gray-600 hover:bg-gray-500 text-sm" %>
      <%= button_to t('.remove'), line_item_path(line_item, locale: I18n.locale),
        method: :delete,
        form_class: "inline ml-2",
        class: "text-xs text-gray-500 hover:text-red-600 hover:underline bg-transparent p-0" %>
    <% end %>
  </td>
</tr>
