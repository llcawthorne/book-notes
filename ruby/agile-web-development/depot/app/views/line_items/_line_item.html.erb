<% if line_item == @current_item %>
  <tr class="line-item-highlight" id="<%= dom_id(line_item) %>">
<% else %>
  <tr id="<%= dom_id(line_item) %>">
<% end %>
  <td class="text-right">
    <% if line_item.cart_id.present? %>
      <div class="inline-flex items-center gap-1">
        <%= button_to "−", decrement_line_item_path(line_item, locale: I18n.locale),
          method: :patch,
          form_class: "inline",
          class: "rounded-md w-6 h-6 leading-none text-white bg-gray-600 hover:bg-gray-500 text-sm",
          "aria-label": t(".decrement") %>
        <span class="inline-block w-4 text-center"><%= line_item.quantity %></span>
        <%= button_to "+", increment_line_item_path(line_item, locale: I18n.locale),
          method: :patch,
          form_class: "inline",
          class: "rounded-md w-6 h-6 leading-none text-white bg-gray-600 hover:bg-gray-500 text-sm",
          "aria-label": t(".increment") %>
      </div>
    <% else %>
      <%= line_item.quantity %>
    <% end %>
  </td>
  <td>&times;</td>
  <td class="pr-2">
    <%= line_item.product.title %>
  </td>
  <td class="text-right font-bold">
    <%= localized_currency(line_item.total_price) %>
  </td>
</tr>
