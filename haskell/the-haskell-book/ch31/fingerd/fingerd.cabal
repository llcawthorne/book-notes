cabal-version:       2.2

name:                fingerd
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/llcawthorne/fingerd#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Lewis Cawthorne
maintainer:          llcawthorne@gmail.com
copyright:           2026 Lewis Cawthorne
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable debug
  ghc-options:        -Wall
  hs-source-dirs:     src
  main-is:            Debug.hs
  default-language:   Haskell2010
  build-depends:      base >= 4.7 && < 5
                    , network

executable fingerd
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , bytestring
                     , network
                     , raw-strings-qq
                     , sqlite-simple
                     , text
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

source-repository head
  type:     git
  location: https://github.com/githubuser/fingerd
